    "lint": "bunx eslint ."
  },
  "peerDependencies": {
    "convex": ">=1.43.0",
    "valibot": ">=1.0.0"
  },
  "devDependencies": {
    "convex": "^1.45.0",
    "valibot": "^1.0.0",
    "typescript": "^5.8.2"
  }
}
