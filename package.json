{
  "name": "convex-valibot-helpers",
  "version": "0.2.1",
  "description": "Valibot ↔ Convex bridge — convert Valibot schemas to Convex validators, plus Zod-style custom query/mutation/action builders.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "a-fatah",
  "homepage": "https://github.com/a-fatah/convex-valibot-helpers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-fatah/convex-valibot-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/a-fatah/convex-valibot-helpers/issues"
  },
  "keywords": [
    "convex",
    "valibot",
    "validator",
    "schema",
    "convex-helpers",
    "typescript"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
